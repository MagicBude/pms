# Copy only the variables needed by the selected profile into your protected environment.
DJANGO_SETTINGS_MODULE=pms.settings.local
PMS_BIND_HOST=127.0.0.1
PMS_BIND_PORT=8000
PMS_STARTUP_TIMEOUT_SECONDS=30
PMS_DEBUG=false
PMS_DATA_DIR=data

# First-install secret only. Remove it from the process environment immediately after
# initialize_pms succeeds; repeated initialization never resets an existing password.
# PMS_INITIAL_ADMIN_PASSWORD=

# Generate a unique secret for every LAN or cloud deployment. Never commit its value.
# PMS_SECRET_KEY=
# PMS_ALLOWED_HOSTS=pms.example.internal
# PMS_DB_NAME=pms
# PMS_DB_USER=pms
# PMS_DB_PASSWORD=
# PMS_DB_HOST=127.0.0.1
# PMS_DB_PORT=5432
